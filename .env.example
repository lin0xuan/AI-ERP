# Copy to .env. Use KEY=value without quotes; restart the backend after editing.
# Shared SiliconFlow key for chat, memory extraction, summaries and embeddings.
# A nonempty key here overrides the model configured in the ERP settings page.
SILICONFLOW_API_KEY=
AI_CHAT_ENDPOINT=https://api.siliconflow.cn/v1
AI_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# BGE is the embedding model. ChromaDB is not required.
AI_MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
AI_MEMORY_EMBEDDING_ENDPOINT=https://api.siliconflow.cn/v1
# Optional separate embedding key. Leave empty to use the shared/default model key.
AI_MEMORY_EMBEDDING_API_KEY=
